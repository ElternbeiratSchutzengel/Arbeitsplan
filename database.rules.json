{
  "rules": {
    "config": {
      ".read": true,
      ".write": true,
      "clubName": {
        ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
      },
      "eventName": {
        ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
      },
      "eventDate": {
        ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
      },
      "eventLocation": {
        ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
      },
      "tagline": {
        ".validate": "newData.isString() && newData.val().length <= 160"
      },
      "adminSalt": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9a-fA-F]{32}$/)"
      },
      "adminHash": {
        ".validate": "newData.isString() && newData.val().matches(/^[0-9a-fA-F]{64}$/)"
      },
      "$other": {
        ".validate": false
      }
    },
    "groups": {
      ".read": true,
      ".write": true,
      "$groupId": {
        ".validate": "newData.hasChildren(['name','color','order'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().matches(/^(sky|teal|indigo|rose|amber|violet|emerald|slate)$/)"
        },
        "order": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "shifts": {
      ".read": true,
      ".write": true,
      "$shiftId": {
        ".validate": "newData.hasChildren(['name','start','end','order'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "start": {
          ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
        },
        "end": {
          ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
        },
        "order": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stands": {
      ".read": true,
      ".write": true,
      "$standId": {
        ".validate": "newData.hasChildren(['name','icon','color','order'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "icon": {
          ".validate": "newData.isString() && newData.val().matches(/^(flame|beer|cash|cake|droplet|coffee|music|ticket|salad|waffle|ice-cream|fries|popcorn|candy|sausage|lemonade|tea|wine|cocktail|star|users|child|heart|balloon|gift|game|tent)$/)"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().matches(/^(sky|teal|indigo|rose|amber|violet|emerald|slate)$/)"
        },
        "groupId": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
        },
        "order": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "demand": {
      ".read": true,
      ".write": true,
      "$shiftId": {
        "$standId": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && newData.val() % 1 === 0"
        }
      }
    },
    "assignments": {
      ".read": true,
      ".write": true,
      "$shiftId": {
        "$standId": {
          "$slotIndex": {
            ".validate": "newData.hasChildren(['name','createdAt','updatedAt']) && $slotIndex.matches(/^(0|[1-9][0-9]*)$/) && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 60 && newData.child('createdAt').isNumber() && newData.child('createdAt').val() > 0 && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() >= newData.child('createdAt').val()",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "audit_log": {
      ".read": false,
      ".write": true,
      "$logId": {
        ".validate": "newData.hasChildren(['ts','action','entity','entityId','actor','source']) && newData.child('ts').isNumber() && newData.child('ts').val() > 0 && newData.child('action').isString() && newData.child('action').val().matches(/^(create|update|delete|reset)$/) && newData.child('entity').isString() && newData.child('entity').val().matches(/^(assignment|stand|shift|group|demand|config)$/) && newData.child('entityId').isString() && newData.child('entityId').val().length <= 200 && newData.child('actor').isString() && newData.child('actor').val().matches(/^(admin|helper)$/) && newData.child('source').isString() && newData.child('source').val().matches(/^(ui|import|system)$/)",
        "ts": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "action": {
          ".validate": "newData.isString() && newData.val().matches(/^(create|update|delete|reset)$/)"
        },
        "entity": {
          ".validate": "newData.isString() && newData.val().matches(/^(assignment|stand|shift|group|demand|config)$/)"
        },
        "entityId": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "shiftId": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "standId": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "slotIndex": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
        },
        "oldValue": {
          ".validate": "newData.exists()"
        },
        "newValue": {
          ".validate": "newData.exists()"
        },
        "actor": {
          ".validate": "newData.isString() && newData.val().matches(/^(admin|helper)$/)"
        },
        "source": {
          ".validate": "newData.isString() && newData.val().matches(/^(ui|import|system)$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
